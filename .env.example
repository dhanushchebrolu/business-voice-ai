# Environment variables Vaani's server code reads. This file documents
# names only — never put real values here or commit real secrets anywhere
# in the repository. See CLAUDE.md/PHASE_*_FINAL_REPORT.md for which phase
# introduced each group.

# --- Supabase (Klyro Ai project) ---
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_PROJECT_ID and their
# VITE_-prefixed client-visible equivalents are NOT committed anywhere in
# this repository — `.env` is gitignored (see .gitignore), so a fresh
# clone/pull has none of these set. (Lovable's own hosted sandbox
# auto-provisions a local, non-committed `.env` outside git for its own
# preview environment — that is a property of that hosted environment,
# not of this repository, and does not carry over to a plain `git clone`
# or `git pull` elsewhere.)
#
# To build or run this project locally: copy this file to `.env` (or
# `.env.local`) in the repo root and fill in the two VITE_-prefixed values
# below from your Supabase project's dashboard (Project Settings → API —
# the "Project URL" and the "anon"/"publishable" key). Both are
# public-safe by design (a publishable key, not a secret) — safe to ship
# in the browser bundle, but still never commit the filled-in file itself.
#
# `npm run build` / `vite build` FAILS FAST if VITE_SUPABASE_URL or
# VITE_SUPABASE_PUBLISHABLE_KEY is missing at build time (see
# vite.config.ts's validateSupabasePublicEnv plugin) — they are compiled
# into the client bundle as literal strings, so nothing set afterward (a
# Cloudflare Worker runtime variable, a dashboard secret) can fix an
# already-built bundle. See DEPLOYMENT.md for where these two must ALSO be
# configured for a Cloudflare Workers Builds deploy, which runs its own
# fresh build and has no access to your local `.env`.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The service-role/secret key is NOT public-safe. It must never go in this
# file with a real value, never in a VITE_-prefixed variable, and never in
# a committed file — set it locally in .env.local (already covered by
# the *.local rule in .gitignore) or as a real server-side deployment
# secret, never here:
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform admin bootstrap (Phase B) ---
# Set once, out-of-band, to claim the first platform super admin. Leave
# unset after bootstrap is complete.
PLATFORM_ADMIN_BOOTSTRAP_SECRET=

# --- Razorpay (Phase C) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Telephony (Phase D) ---
# Public base URL this server is reachable at, used to build the outbound
# call callback URL passed to a telephony provider.
TELEPHONY_WEBHOOK_BASE_URL=
# Set to "true" only in local/dev testing to enable the deterministic mock
# telephony provider (telephony/mock-provider.ts). Never set in production.
TELEPHONY_ALLOW_MOCK=

# One block per provider you actually connect (see telephony.server.ts's
# TELEPHONY_PROVIDERS for the exact secret name(s) each provider expects,
# and getTelephonyAdapter() for BASE_URL/WEBHOOK_SECRET naming):
#   {PROVIDER}_BASE_URL=
#   {PROVIDER}_WEBHOOK_SECRET=
#   plus that provider's own required secret(s), e.g.:
SARVAM_TELEPHONY_ACCOUNT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMARTFLO_TOKEN=
VOBIZ_API_KEY=
PULSE_API_KEY=
INTALK_API_KEY=

# --- Sarvam AI voice runtime (Phase E) ---
# Required for both the existing REST integration (sarvam.server.ts — chat
# completion, batch TTS) and the Phase E realtime WebSocket clients
# (sarvam-realtime.server.ts — streaming STT/TTS). Server-side only; never
# exposed to the browser. Also used as the legacy single-key fallback for
# Sarvam Voice Agents managed telephony (telephony.server.ts) if the
# dedicated keys below are not set.
SARVAM_API_KEY=
# Sarvam Voice Agents management API keys (deployment/campaign/instant-
# outbound calls — see sarvam-admin.functions.ts and
# sarvam-inbound-deployment.server.ts). The account may issue one key that
# works for both directions (set SARVAM_VOICE_AGENTS_API_KEY) or two
# separate ones; resolveSarvamKeys() (telephony.server.ts) tries, in order:
# SARVAM_INBOUND_VOICE_API_KEY / SARVAM_OUTBOUND_VOICE_API_KEY, then
# SARVAM_VOICE_AGENTS_API_KEY, then the legacy SARVAM_API_KEY above. Not
# needed for the inbound/outbound webhook-processing path itself.
SARVAM_INBOUND_VOICE_API_KEY=
SARVAM_OUTBOUND_VOICE_API_KEY=
SARVAM_VOICE_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Optional (Phase 5). When set, the telephony webhook additionally accepts a
# request whose `verify_token` query parameter matches this value — a
# Klyro-generated shared secret, not a Sarvam-issued one (see
# sarvam-provider.server.ts's verifyWebhookSignature doc comment for exactly
# what this does and does not prove). Leave unset to keep the Sarvam webhook
# path rejecting every request until Sarvam's own signing mechanism is
# confirmed and implemented.
SARVAM_WEBHOOK_SECRET=
# Required (Task #94) for the Sarvam client-context endpoint
# (/api/public/sarvam/client-context — see sarvam-client-context.server.ts).
# A Klyro-generated shared secret checked via the request's `verify_token`
# query parameter, same mechanism as SARVAM_WEBHOOK_SECRET above. The
# endpoint fails closed (503) until this is set — configure it into
# whichever URL is wired into Sarvam's dashboard for this purpose (a manual,
# per-deployment step; see that file's module doc for exactly why).
SARVAM_CONTEXT_SECRET=

# --- Claude (Anthropic) / Gemini (Google) voice-agent LLM, selectable via VOICE_LLM_PROVIDER (see llm-provider.server.ts) ---
# Optional. This live phone-call pipeline runs on Sarvam end to end today
# (STT, TTS, and the LLM turn) — none of this is required unless you
# explicitly opt in. Speech-to-text and text-to-speech are ALWAYS Sarvam's
# realtime clients regardless of this setting; only the text-in/text-out
# reasoning step (voice-runtime.server.ts's generateReply) is affected. The
# business-grounding system prompt (agent-instructions.ts — business name,
# hours, services, pricing, FAQs, knowledge base, rules) is built the same
# way and sent to whichever provider is selected here.
#
# Set to "claude" to have that reasoning step call Claude (claude.server.ts)
# instead of Sarvam's /v1/chat/completions, or "gemini" to call Gemini
# (gemini.server.ts). Any other value, or leaving this unset, keeps the
# existing Sarvam behavior — this never changes on its own just because
# ANTHROPIC_API_KEY or GEMINI_API_KEY happens to be set.
VOICE_LLM_PROVIDER=
# Required only when VOICE_LLM_PROVIDER=claude. Server-side only, never
# exposed to the browser or sent anywhere except https://api.anthropic.com.
ANTHROPIC_API_KEY=
# Optional. Defaults to "claude-sonnet-5" (claude.server.ts's DEFAULT_MODEL)
# if unset.
CLAUDE_MODEL=
# Required only when VOICE_LLM_PROVIDER=gemini. Server-side only, never
# exposed to the browser or sent anywhere except
# https://generativelanguage.googleapis.com. Note: Google's API takes this
# key as a URL query parameter (its own documented auth mechanism, not a
# choice made here) — never logged, never echoed in an error message.
GEMINI_API_KEY=
# Optional. Defaults to "gemini-2.5-flash" (gemini.server.ts's DEFAULT_MODEL)
# if unset.
GEMINI_MODEL=

# --- Exotel bidirectional media transport (Phase D.1) ---
# Exotel's real credential shape (Account SID + API Key + API Token) does
# not fit the generic {PROVIDER}_BASE_URL/{PROVIDER}_WEBHOOK_SECRET pattern
# above — it has its own dedicated construction path in telephony.server.ts.
# See PHASE_D1_EXOTEL_FINAL_REPORT.md §5/§21 for what each is used for and
# what could not be independently verified in this environment.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_TOKEN=
# Region/account-specific API host — defaults to api.exotel.com if unset.
EXOTEL_SUBDOMAIN=
# Compared against the `verify_token` query parameter Exotel is configured
# to send back (Exotel does not sign webhooks with a header — see the
# report). Used for both the call-status webhook and the optional
# media-session-token minting endpoint.
EXOTEL_WEBHOOK_SECRET=
# Signs the short-lived opaque media-session token (media-session-token.ts)
# — a defense-in-depth second factor on top of the mandatory CallSid+DB
# check in exotel-media-route.server.ts. A long random value, unrelated to
# any Exotel credential.
MEDIA_SESSION_TOKEN_SECRET=

# --- WhatsApp Business Platform (Meta Embedded Signup v4, Phase 2) ---
# ClickAI operates as a Meta TECH PROVIDER, not a Solution Partner: each
# onboarded customer owns their own WhatsApp Business Account and pays
# Meta directly for conversations (see the Phase 2 verification report for
# what this does and does not mean for pricing.whatsapp_message).
#
# From the Meta App Dashboard -> your App -> App settings -> Basic.
# META_APP_SECRET must NEVER be exposed to the browser, committed, or
# logged — see meta-client.server.ts. META_APP_ID is not secret (it is
# safe to expose to the browser for the FB.login() call in a later phase)
# but is documented here as a server-side value too, since
# whatsapp-onboarding.functions.ts reads it server-side for the code
# exchange; a later phase may additionally mirror it into a VITE_-prefixed
# variable for the frontend SDK call.
META_APP_ID=
META_APP_SECRET=
# The Facebook Login for Business configuration id (Embedded Signup v4
# "Configuration Builder" — App Dashboard -> Facebook Login for Business ->
# Configurations -> the WhatsApp Embedded Signup template). Not a secret.
META_WHATSAPP_CONFIG_ID=
# Graph API version, e.g. "v23.0". Deliberately has NO code-level default
# — this session could not independently verify the current Meta Graph API
# version (network egress to developers.facebook.com is blocked in this
# environment). Set this to whatever version the Meta App Dashboard shows
# as current at deploy time; see meta-config.server.ts's doc comment.
META_GRAPH_API_VERSION=
# 32 random bytes, base64-encoded (generate with: openssl rand -base64 32).
# Encrypts whatsapp_connections.access_token_ciphertext /
# two_step_pin_ciphertext (AES-256-GCM — see whatsapp-token-crypto.
# server.ts). Losing this key makes every already-stored WhatsApp
# credential permanently undecryptable; rotating it requires re-onboarding
# every connected number. Never commit a real value here.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
# Checked by GET /api/public/webhooks/whatsapp against Meta's
# hub.verify_token query param during the app's webhook subscription
# handshake (and any later resubscribe). A Klyro-generated shared secret
# you choose yourself, not a Meta-issued one — pick any strong random
# value and enter the SAME value into the Meta App Dashboard's webhook
# subscription form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- WhatsApp payment message templates (Phase 4) ---
# Optional. Meta only allows free-form text replies within 24h of the
# customer's last inbound message; outside that window, a pre-approved
# Meta Message Template is required instead. If the window has closed and
# no template is configured for a given purpose, sendWhatsAppPaymentMessage
# fails explicitly (recorded as a delivery failure — booking/payment state
# is never affected either way) rather than attempting a doomed free-form
# send. Each purpose needs its own approved template configured in the
# Meta Business Manager first; _LANGUAGE defaults to en_US if omitted.
# Leave all unset until templates have been created and approved with Meta.
WHATSAPP_TEMPLATE_PAYMENT_LINK_NAME=
WHATSAPP_TEMPLATE_PAYMENT_LINK_LANGUAGE=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION_NAME=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMATION_LANGUAGE=
WHATSAPP_TEMPLATE_PAYMENT_FAILED_NAME=
WHATSAPP_TEMPLATE_PAYMENT_FAILED_LANGUAGE=
WHATSAPP_TEMPLATE_PAYMENT_EXPIRED_NAME=
WHATSAPP_TEMPLATE_PAYMENT_EXPIRED_LANGUAGE=

# --- Instagram (Meta Facebook Login, Phase 5) ---
# Reuses the SAME shared Meta App as WhatsApp above — META_APP_ID/
# META_APP_SECRET/META_GRAPH_API_VERSION are NOT duplicated here (see
# instagram-config.server.ts's module doc for why Instagram uses a plain
# OAuth 2.0 redirect flow, not WhatsApp's Embedded Signup popup).
#
# Must exactly match the redirect URI registered for this app's Facebook
# Login product, including scheme and trailing path.
# Example: https://clickai.in/api/public/integrations/instagram/callback
INSTAGRAM_REDIRECT_URI=
# 32 random bytes, base64-encoded (generate with: openssl rand -base64 32).
# Encrypts instagram_connections.access_token_ciphertext (AES-256-GCM —
# see instagram-token-crypto.server.ts). Deliberately a SEPARATE key from
# WHATSAPP_CREDENTIAL_ENCRYPTION_KEY/GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY/
# RAZORPAY_CREDENTIAL_ENCRYPTION_KEY — rotating one provider's key never
# touches another's already-stored ciphertext. Losing this key makes every
# already-stored Instagram credential permanently undecryptable; rotating
# it requires every connected account to reconnect. Never commit a real
# value here.
INSTAGRAM_CREDENTIAL_ENCRYPTION_KEY=
# Checked by GET /api/public/webhooks/instagram against Meta's
# hub.verify_token query param during the app's webhook subscription
# handshake. A ClickAI-generated shared secret you choose yourself, not a
# Meta-issued one — pick any strong random value and enter the SAME value
# into the Meta App Dashboard's Instagram webhook subscription form.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
#
# NOTE: Every Instagram messaging/comments permission requested during
# OAuth (instagram_manage_messages, instagram_manage_comments) is an
# Advanced Access permission subject to Meta App Review — until ClickAI's
# Meta App passes review for them, this connection flow only works for
# Instagram accounts that are Meta-registered testers/admins of ClickAI's
# own Meta App. See instagram-connection.server.ts's module doc.

# --- WhatsApp Embedded Signup v4 frontend (Phase 3) ---
# Client-visible mirrors of META_APP_ID/META_WHATSAPP_CONFIG_ID/
# META_GRAPH_API_VERSION above, exactly like VITE_SUPABASE_URL/VITE_
# SUPABASE_PUBLISHABLE_KEY mirror their own server-side values at the top
# of this file. Safe to expose: an App ID and a Facebook Login for
# Business config_id are not secrets (this is explicit in Meta's own docs
# and in the Phase 3 spec) — only META_APP_SECRET is. Unlike the Supabase
# pair, these are NOT build-time-required: WhatsApp is an optional
# feature (same as Sarvam/Exotel/Claude/Gemini above), so the build must
# succeed with these unset — app.whatsapp.tsx checks for their presence at
# runtime and shows a "not configured" state instead of ever throwing.
VITE_META_APP_ID=
VITE_META_WHATSAPP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=

# --- Google Calendar integration (Phase 2) ---
# Optional feature, same as WhatsApp/Sarvam/Exotel above: the build must
# succeed with these unset, and app.integrations.tsx shows a
# "not configured" state at runtime instead of throwing
# (google-calendar-config.server.ts's resolveGoogleCalendarConfig()
# returns null rather than throwing when any of these three are missing).
#
# Google Cloud setup (one-time, per deployment):
#   1. Create or select a Google Cloud project.
#   2. Enable the "Google Calendar API" for that project.
#   3. Configure the OAuth consent screen (External or Internal, per your
#      Google Workspace setup).
#   4. Create an OAuth 2.0 Client ID (type: Web application) under
#      APIs & Services -> Credentials.
#   5. Add this exact redirect URI to that client's "Authorized redirect
#      URIs": <your ClickAI origin>/api/public/integrations/google-calendar/callback
#      — this MUST byte-for-byte match GOOGLE_CALENDAR_REDIRECT_URI below.
#   6. Copy the generated Client ID and Client Secret into the two
#      variables below.
#   7. Requested scopes are NOT an env var — they're centralized as
#      GOOGLE_CALENDAR_SCOPES in google-calendar-config.server.ts
#      (calendar.readonly + calendar.events; nothing broader).
#
# GOOGLE_CALENDAR_CLIENT_SECRET must NEVER be exposed to the browser,
# committed, or logged. GOOGLE_CALENDAR_CLIENT_ID is not secret (Google's
# own docs treat OAuth client IDs as public) but is kept server-side here
# since the code exchange happens entirely server-side
# (google-oauth.server.ts) — there is no frontend SDK call that needs it
# mirrored into a VITE_-prefixed variable, unlike Meta's embedded signup.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Must exactly match the redirect URI registered in step 5 above,
# including scheme and trailing path — Google rejects any mismatch.
# Example: https://clickai.in/api/public/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# 32 random bytes, base64-encoded (generate with: openssl rand -base64 32).
# Encrypts google_calendar_connections.encrypted_credentials (a JSON blob
# holding the refresh token — AES-256-GCM, see google-calendar-crypto.
# server.ts). Losing this key makes every already-stored Google Calendar
# credential permanently undecryptable; rotating it requires every
# connected business to reconnect. Never commit a real value here.
GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY=

# --- Razorpay merchant connections (Phase 3) ---
# IMPORTANT — these are NOT the same thing as RAZORPAY_KEY_ID/
# RAZORPAY_KEY_SECRET/RAZORPAY_WEBHOOK_SECRET above (Phase C). Those belong
# to ClickAI's OWN platform billing Razorpay account (an organization
# paying ClickAI for its ClickAI subscription — payment_orders/payments/
# webhook_events). The variables below are for a completely separate
# feature: letting each CLIENT BUSINESS connect its OWN Razorpay merchant
# account, so that business's own customers can eventually pay that
# business directly (Phase 4). ClickAI never routes one business's
# payments through another business's, or through ClickAI's own, Razorpay
# account. Never reuse or mix these two credential sets.
#
# If any of RAZORPAY_CLIENT_ID / RAZORPAY_CLIENT_SECRET /
# RAZORPAY_REDIRECT_URI / RAZORPAY_OAUTH_AUTHORIZE_URL /
# RAZORPAY_OAUTH_TOKEN_URL / RAZORPAY_OAUTH_SCOPE is unset, the Razorpay
# integration simply reports a "not configured" state at runtime instead
# of throwing (razorpay-config.server.ts's resolveRazorpayConfig() returns
# null rather than throwing when any of these are missing) — the app
# boots and serves every other feature normally either way.
#
# RAZORPAY_CLIENT_ID / RAZORPAY_CLIENT_SECRET: from Razorpay's Partner/
# OAuth app registration (Razorpay Dashboard -> Partner integration ->
# OAuth apps). RAZORPAY_CLIENT_SECRET must NEVER be exposed to the
# browser, committed, or logged. The code exchange happens entirely
# server-side (razorpay-oauth.server.ts), so neither of these needs a
# VITE_-prefixed mirror.
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
# Must exactly match the redirect URI registered with Razorpay for this
# OAuth app, including scheme and trailing path.
# Example: https://clickai.in/api/public/integrations/razorpay/callback
RAZORPAY_REDIRECT_URI=
#
# NOTE ON THE THREE VARIABLES BELOW: this codebase's build sandbox has no
# network egress to razorpay.com, so the exact current Razorpay Partner
# OAuth authorize/token endpoint URLs and the exact scope string could NOT
# be independently verified against live Razorpay documentation when this
# integration was built. Rather than hardcode a guessed value, these are
# left as required, explicit configuration (the same "no hardcoded
# default where genuinely uncertain" precedent already used for
# META_GRAPH_API_VERSION elsewhere in this file). Confirm the current,
# correct values from your Razorpay Partner OAuth app's own documentation/
# dashboard before setting these.
RAZORPAY_OAUTH_AUTHORIZE_URL=
RAZORPAY_OAUTH_TOKEN_URL=
RAZORPAY_OAUTH_SCOPE=
#
# Optional. If Razorpay's OAuth-for-Partners flow exposes a dedicated
# "fetch connected merchant profile" endpoint separate from the token
# response itself, set its URL here (see fetchMerchantDetails() in
# razorpay-oauth.server.ts). Leave unset if unsure or not needed — the
# integration falls back to whatever identifier the token-exchange
# response itself provides, and connection verification still works
# (verifyRazorpayConnection() uses a token refresh as its health check
# either way) — this is not required for Phase 3 to function.
RAZORPAY_MERCHANT_DETAILS_URL=
# 32 random bytes, base64-encoded (generate with: openssl rand -base64 32).
# Encrypts razorpay_connections.encrypted_credentials (a JSON blob holding
# the access/refresh token — AES-256-GCM, see razorpay-crypto.server.ts).
# Deliberately a SEPARATE key from GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY
# above — rotating one provider's key never touches another's already-
# stored ciphertext. Losing this key makes every already-stored Razorpay
# credential permanently undecryptable; rotating it requires every
# connected business to reconnect. Never commit a real value here.
RAZORPAY_CREDENTIAL_ENCRYPTION_KEY=

# --- Razorpay CUSTOMER payment transactions (Phase 4) ---
# IMPORTANT — this is a THIRD, separate Razorpay credential set, distinct
# from both RAZORPAY_KEY_ID/KEY_SECRET/WEBHOOK_SECRET (Phase C, ClickAI's
# own platform billing) and RAZORPAY_CLIENT_ID/CLIENT_SECRET (Phase 3, the
# merchant OAuth connection). This one is ONLY the signing secret for the
# webhook Razorpay sends about a CLIENT BUSINESS's customer payments
# (payment_requests / payment_link.* events) — never mix it up with the
# other two. See razorpay-payments.server.ts's module doc comment for why
# this webhook stream is kept on its own route
# (/api/public/webhooks/razorpay-payments) with its own idempotency ledger
# (payment_webhook_events) rather than sharing infrastructure with either
# of the other two Razorpay integrations.
RAZORPAY_CUSTOMER_PAYMENTS_WEBHOOK_SECRET=
#
# NOTE ON THE TWO VARIABLES BELOW: same network-egress constraint as
# razorpay-config.server.ts's OAuth endpoints — this sandbox could not
# independently verify Razorpay's Payment Links API request/response shape
# against live documentation. The base URL DOES have in-repo precedent
# (razorpay.server.ts's ClickAI-platform-billing Orders API calls already
# use https://api.razorpay.com/v1 with Basic auth), so
# RAZORPAY_PAYMENTS_API_BASE_URL defaults to that same, already-verified-
# in-this-codebase host if left unset — override only if Razorpay's
# Partner/OAuth "on behalf of a connected account" flow requires a
# different host. RAZORPAY_ACCOUNT_HEADER_NAME defaults to the
# `X-Razorpay-Account` header name (Razorpay's documented general pattern
# for a Partner acting on behalf of a connected account, per training-data
# knowledge — NOT independently reverified live in this session). BOTH
# MUST BE CONFIRMED AGAINST LIVE RAZORPAY PARTNER OAUTH DOCUMENTATION
# BEFORE PRODUCTION USE.
RAZORPAY_PAYMENTS_API_BASE_URL=
RAZORPAY_ACCOUNT_HEADER_NAME=
