# Environment variables Vaani's server code reads. This file documents
# names only — never put real values here or commit real secrets anywhere
# in the repository. See CLAUDE.md/PHASE_*_FINAL_REPORT.md for which phase
# introduced each group.

# --- Supabase (Lovable Cloud) ---
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_PROJECT_ID and their
# VITE_-prefixed client-visible equivalents already live in the tracked
# .env file — they are public-safe (a publishable key, not a secret) by
# design. The service-role key is NOT public-safe and must never go in a
# tracked file:
SUPABASE_SERVICE_ROLE_KEY=

# --- Platform admin bootstrap (Phase B) ---
# Set once, out-of-band, to claim the first platform super admin. Leave
# unset after bootstrap is complete.
PLATFORM_ADMIN_BOOTSTRAP_SECRET=

# --- Razorpay (Phase C) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Telephony (Phase D) ---
# Public base URL this server is reachable at, used to build the outbound
# call callback URL passed to a telephony provider.
TELEPHONY_WEBHOOK_BASE_URL=
# Set to "true" only in local/dev testing to enable the deterministic mock
# telephony provider (telephony/mock-provider.ts). Never set in production.
TELEPHONY_ALLOW_MOCK=

# One block per provider you actually connect (see telephony.server.ts's
# TELEPHONY_PROVIDERS for the exact secret name(s) each provider expects,
# and getTelephonyAdapter() for BASE_URL/WEBHOOK_SECRET naming):
#   {PROVIDER}_BASE_URL=
#   {PROVIDER}_WEBHOOK_SECRET=
#   plus that provider's own required secret(s), e.g.:
SARVAM_TELEPHONY_ACCOUNT=
EXOTEL_SID=
EXOTEL_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMARTFLO_TOKEN=
VOBIZ_API_KEY=
PULSE_API_KEY=
INTALK_API_KEY=

# --- Sarvam AI voice runtime (Phase E) ---
# Required for both the existing REST integration (sarvam.server.ts — chat
# completion, batch TTS) and the Phase E realtime WebSocket clients
# (sarvam-realtime.server.ts — streaming STT/TTS). Server-side only; never
# exposed to the browser.
SARVAM_API_KEY=
