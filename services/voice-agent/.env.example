# Names only. Values come from the secret manager of each environment; never commit them.
APP_ENV=development            # development | staging | production
LIVEKIT_URL=                   # wss://<project>.livekit.cloud (or self-hosted wss://…)
LIVEKIT_ALLOWED_HOSTS=         # self-hosted LiveKit only: exact extra hosts (outside development only *.livekit.cloud otherwise)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SARVAM_API_KEY=
KLYRO_BASE_URL=                # https://<environment's klyro host>
VOICE_AGENT_HMAC_SECRET=       # same value as klyro's VOICE_AGENT_HMAC_SECRET (>= 32 chars)
VOICE_AGENT_HMAC_KEY_ID=current
AGENT_NAME=clickai-receptionist
LLM_PROVIDER=anthropic         # sarvam | anthropic. sarvam = Sarvam only (SARVAM_API_KEY), no fallback; anthropic = pre-2.18 setup until Sarvam acceptance
SARVAM_LLM_MODEL=sarvam-105b-conversations  # sarvam-105b-conversations | sarvam-105b
SARVAM_LLM_REASONING_EFFORT=   # optional: low | medium | high (unset = not sent; benchmark before setting)
ANTHROPIC_API_KEY=             # LLM_PROVIDER=anthropic only: Claude via LiveKit's Anthropic plugin
CLAUDE_MODEL=                  # same model id klyro uses (CLAUDE_MODEL)
FALLBACK_LLM_BASE_URL=         # LLM_PROVIDER=anthropic only (refused with sarvam): optional OpenAI-compatible fallback
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
MAX_CONCURRENT_SESSIONS=8
HEALTH_PORT=8081
DRAIN_TIMEOUT_MS=1860000
KLYRO_TIMEOUT_MS=4000
SILENCE_TIMEOUT_S=15
MAX_CALL_SECONDS=1800
# Provisioning script only (deploy/livekit/provision-sip.ts)
VOBIZ_SIP_SIGNALING_IPS=       # comma-separated CIDRs from Vobiz's IP-whitelisting page
VOBIZ_OUTBOUND_SIP_DOMAIN=     # <trunk_id>.sip.vobiz.ai
VOBIZ_OUTBOUND_SIP_USERNAME=
VOBIZ_OUTBOUND_SIP_PASSWORD=
SIP_INBOUND_NUMBERS=           # comma-separated E.164 numbers migrated to SIP (number-by-number)
TURN_DETECTION=multilingual          # multilingual | vad (degraded: silence-based turns, no model files)
SIP_OUTBOUND_TRUNK_ID=         # LiveKit outbound trunk id printed by provision:sip; unset = outbound dials refused.
                               # The agent dials only numbers klyro returns from its claim endpoint, never dispatch metadata.
