# Local voice stack (deploy/docker-compose.dev.yml). Copy is created by
# init-env.sh as deploy/local/.env (git-ignored, mode 600) with generated
# secrets. NEVER put staging or production values here and never commit .env.

# --- Generated by init-env.sh (local only) ---
# LiveKit API key id (public) and secret (>= 32 chars), shared by the server,
# SIP service, agent, smoke test and any local klyro you point at this stack.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Redis password (Redis is on an internal network only).
REDIS_PASSWORD=
# Agent <-> klyro request signing (same value as klyro's VOICE_AGENT_HMAC_SECRET
# when you point the agent at a local klyro).
VOICE_AGENT_HMAC_SECRET=

# --- You provide ---
# Sarvam API key: STT saaras:v3, TTS bulbul:v3 and the LLM. Use a key with a
# spending limit. The stack does not call Sarvam until a call is answered.
SARVAM_API_KEY=

# --- Optional (defaults in brackets) ---
# Where the agent sends its signed klyro calls and where LiveKit posts webhooks.
# [http://host.docker.internal:8790] = the smoke test's fake klyro.
# For a local klyro dev server use e.g. http://host.docker.internal:3000.
KLYRO_BASE_URL=
# [http://host.docker.internal:8790/api/public/webhooks/livekit]
LIVEKIT_WEBHOOK_URL=
# Self-hosted LiveKit host(s) for APP_ENV staging/production (comma-separated,
# exact hostnames). Not enforced with APP_ENV=development (this stack).
LIVEKIT_ALLOWED_HOSTS=
# [clickai-receptionist] Must equal the SIP dispatch rule's agent name.
AGENT_NAME=
# [sarvam-105b-conversations] or sarvam-105b
SARVAM_LLM_MODEL=
# [multilingual] or vad. vad needs no model files.
VOICE_AGENT_TURN_DETECTION=
# [1] Bake the turn-detector model into the image (needs huggingface.co).
# 0 only together with VOICE_AGENT_TURN_DETECTION=vad.
VOICE_AGENT_DOWNLOAD_TURN_DETECTOR=
# [2] Calls per agent container.
VOICE_AGENT_MAX_CONCURRENT_SESSIONS=
# [127.0.0.1] Host IP for LiveKit and agent ports; [127.0.0.1] for SIP ports.
# WARNING: LiveKit's API/WebSocket (7880), WebRTC (7881, 50000-50100) and the
# agent health port (8081) are PLAIN HTTP without TLS. Never set
# LOCAL_BIND_IP to 0.0.0.0 or a public/LAN IP: anyone who can reach the port
# gets an unencrypted API whose only protection is the key. Use an SSH tunnel
# instead of widening the bind address.
# Set SIP_BIND_IP=0.0.0.0 and SIP_NAT_1_TO_1_IP=<public IP> only on a host
# that is deliberately reachable from Vobiz (see LOCAL_LIVEKIT.md).
LOCAL_BIND_IP=
SIP_BIND_IP=
SIP_NAT_1_TO_1_IP=
# [detected] IP LiveKit advertises for WebRTC media.
LIVEKIT_NODE_IP=
# [info] debug | info | warn | error
LIVEKIT_LOG_LEVEL=
# [docker.io] Registry for the pinned images, e.g. mirror.gcr.io on HTTP 429.
DOCKERHUB_MIRROR=
# [docker.io/library] Registry for the agent's Node base image, e.g. mirror.gcr.io/library.
NODE_BASE_REGISTRY=
